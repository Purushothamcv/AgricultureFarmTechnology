# ============================================================================
# SmartAgri-AI Backend Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values

# ============================================================================
# MONGODB CONFIGURATION (REQUIRED for authentication features)
# ============================================================================
# Local Development:
MONGODB_URL=mongodb://localhost:27017

# Production (MongoDB Atlas - FREE TIER):
# Get your connection string from https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Example: MONGODB_URL=mongodb+srv://admin:mypassword@cluster0.abc123.mongodb.net/?retryWrites=true&w=majority

DATABASE_NAME=FinalProject

# ============================================================================
# AI CHATBOT CONFIGURATION (REQUIRED for chatbot feature)
# ============================================================================
# Get your free API key from: https://console.groq.com/keys
# Sign up with Google/GitHub, go to API Keys section, create new key
GROQ_API_KEY=your_groq_api_key_here

# ============================================================================
# GOOGLE OAUTH CONFIGURATION (REQUIRED for Google Sign-in)
# ============================================================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=745305741156-di4f6tc9o7p6773hp21mh60u16m3anik.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================================================
# JWT CONFIGURATION (Auto-generated if not set)
# ============================================================================
JWT_SECRET_KEY=your-secret-key-change-this-in-production-2024
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# ============================================================================
# OPTIONAL API KEYS (For additional features)
# ============================================================================
# OpenWeather API for real-time weather data
# Get free key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# News API for agricultural news
# Get free key from: https://newsapi.org/register
NEWSAPI_KEY=your_news_api_key_here

# ============================================================================
# SERVER CONFIGURATION (Auto-configured in production)
# ============================================================================
PORT=8000
HOST=0.0.0.0

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://agriculture-farm-technology.vercel.app
